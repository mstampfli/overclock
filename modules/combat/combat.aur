// OVERCLOCK - shared combat module. The authoritative combat MATH, shared by the
// dedicated server AND the client's local prediction, so a hit/blast/slash resolves
// IDENTICALLY on both sides - no deviation, only lag correction. Every function
// operates on the world::Actor array BY REFERENCE (mutations persist); each caller
// passes its OWN array (the server its World.actors, the client its local actors).
// Shared CODE, separate DATA - that is what stops client/server drift.

fn rifle_dmg() -> f64 { 17.0 }
fn deagle_body_dmg() -> f64 { 40.0 }
fn deagle_leg_dmg() -> f64 { 25.0 }
fn deagle_head_dmg() -> f64 { 120.0 }
fn melee_dmg() -> f64 { 75.0 }
fn melee_range() -> f64 { 2.8 }
fn melee_cooldown() -> f64 { 0.7 }
fn shield_cell_value() -> f64 { 25.0 }
fn blast_dmg() -> f64 { 150.0 }
fn blast_radius() -> f64 { 5.0 }
fn blast_kb_radius() -> f64 { 8.0 }
fn blast_player_kb() -> f64 { 14.0 }
fn rocket_intensity() -> f64 { 1.1 }
fn grenade_intensity() -> f64 { 1.0 }
fn proj_speed() -> f64 { 60.0 }
fn proj_life() -> f64 { 2.2 }

fn weapon_mag_size(wpn: i64) -> i64 {
    if wpn == 1 { return 1 }
    if wpn == 2 { return 7 }
    30
}

fn weapon_reload_time(wpn: i64) -> f64 {
    if wpn == 1 { return 3.0 }
    if wpn == 2 { return 1.2 }
    1.6
}

fn weapon_fire_interval(wpn: i64) -> f64 {
    if wpn == 0 { return 0.11 }
    0.5
}

fn weapon_res_max(wpn: i64) -> i64 {
    if wpn == 1 { return 3 }
    if wpn == 2 { return 28 }
    90
}

fn weapon_res_refill(wpn: i64) -> i64 {
    if wpn == 1 { return 2 }
    if wpn == 2 { return 7 }
    30
}

fn weapon_default_mag(wpn: i64) -> i64 {
    weapon_mag_size(wpn)
}

fn weapon_default_reserve(wpn: i64) -> i64 {
    if wpn == 1 { return 2 }
    if wpn == 2 { return 21 }
    60
}

fn default_mag() -> [i64; 3] { [30, 1, 7] }
fn default_reserve() -> [i64; 3] { [60, 2, 21] }
fn fire_intervals() -> [f64; 3] { [weapon_fire_interval(0), weapon_fire_interval(1), weapon_fire_interval(2)] }
fn reload_times() -> [f64; 3] { [weapon_reload_time(0), weapon_reload_time(1), weapon_reload_time(2)] }
fn mag_sizes() -> [i64; 3] { [weapon_mag_size(0), weapon_mag_size(1), weapon_mag_size(2)] }
fn reserve_caps() -> [i64; 3] { [weapon_res_max(0), weapon_res_max(1), weapon_res_max(2)] }
fn reserve_refills() -> [i64; 3] { [weapon_res_refill(0), weapon_res_refill(1), weapon_res_refill(2)] }

fn select_weapon(actors: [Actor; 9], slot: i64, wpn: i64) -> i64 {
    if slot >= 0 and slot < 9 and wpn >= 0 and wpn <= 2 and actors[slot].wpn != wpn {
        actors[slot].wpn = wpn
        actors[slot].rl = 0.0
        actors[slot].rlw = wpn
        actors[slot].fcd = 0.25
        return 1
    }
    0
}

fn tick_weapon_scaled(actors: [Actor; 9], slot: i64, dt: f64, reload_scale: f64) {
    if actors[slot].rl > 0.0 {
        actors[slot].rl = actors[slot].rl - dt
        if actors[slot].rl <= 0.0 {
            actors[slot].rl = 0.0
            let rw = actors[slot].rlw
            let mut take = weapon_mag_size(rw) - actors[slot].mag[rw]
            if take > actors[slot].res[rw] { take = actors[slot].res[rw] }
            actors[slot].mag[rw] = actors[slot].mag[rw] + take
            actors[slot].res[rw] = actors[slot].res[rw] - take
        }
    }
    let awp = actors[slot].wpn
    if actors[slot].rl <= 0.0 and actors[slot].mag[awp] <= 0 and actors[slot].res[awp] > 0 {
        actors[slot].rl = weapon_reload_time(awp) * reload_scale
        actors[slot].rlw = awp
    }
    actors[slot].fcd = actors[slot].fcd - dt
    if actors[slot].fcd < 0.0 { actors[slot].fcd = 0.0 }
}

fn tick_weapon(actors: [Actor; 9], slot: i64, dt: f64) {
    tick_weapon_scaled(actors, slot, dt, 1.0)
}

fn consume_shot(actors: [Actor; 9], slot: i64, wpn: i64, fire_scale: f64) -> i64 {
    if slot < 0 or slot >= 9 { return 0 }
    if wpn < 0 or wpn > 2 { return 0 }
    if actors[slot].wpn != wpn { select_weapon(actors, slot, wpn) }
    if actors[slot].hp <= 0.0 or actors[slot].heal > 0.0 { return 0 }
    if actors[slot].fcd > 0.0 or actors[slot].rl > 0.0 or actors[slot].mag[wpn] <= 0 { return 0 }
    actors[slot].mag[wpn] = actors[slot].mag[wpn] - 1
    if actors[slot].mag[wpn] <= 0 and actors[slot].res[wpn] > 0 {
        actors[slot].rl = weapon_reload_time(wpn)
        actors[slot].rlw = wpn
    }
    actors[slot].fcd = actors[slot].fcd + weapon_fire_interval(wpn) * fire_scale
    1
}

fn refill_equipped_ammo(actors: [Actor; 9], slot: i64) -> i64 {
    let wpn = actors[slot].wpn
    if actors[slot].res[wpn] < weapon_res_max(wpn) {
        actors[slot].res[wpn] = actors[slot].res[wpn] + weapon_res_refill(wpn)
        if actors[slot].res[wpn] > weapon_res_max(wpn) { actors[slot].res[wpn] = weapon_res_max(wpn) }
        return 1
    }
    0
}

fn apply_shield_cell(actors: [Actor; 9], slot: i64) -> i64 {
    if slot >= 0 and slot < 9 and actors[slot].cells > 0 and actors[slot].sh < actors[slot].shmax {
        actors[slot].cells = actors[slot].cells - 1
        actors[slot].sh = actors[slot].sh + shield_cell_value()
        if actors[slot].sh > actors[slot].shmax { actors[slot].sh = actors[slot].shmax }
        return 1
    }
    0
}

// Apply one hit's damage to actor `vk`: hit-location zoning first (head 2x when the
// impact is above the capsule centre by +0.6, legs 0.65x below -0.4, torso 1x), then
// shield-then-health UNLESS `bypass` is set (the katana goes straight to green hp).
// Returns 1 if it was a headshot so the caller can play the headshot ding. This is the
// single source of truth for: the rifle, the bot rifle, lag-comp'd client shots,
// explosions (pass hrel 0 = no zoning), and the katana (pass bypass 1).
fn apply_hit(actors: [Actor; 9], vk: i64, base: f64, hrel: f64, bypass: i64) -> i64 {
    let mut dmg = base
    let mut head = 0
    if hrel > 0.6 { dmg = dmg * 2.0; head = 1 } else { if hrel < (0.0 - 0.4) { dmg = dmg * 0.65 } }
    if bypass == 0 and actors[vk].sh > 0.0 {
        if actors[vk].sh >= dmg { actors[vk].sh = actors[vk].sh - dmg; dmg = 0.0 }
        else { dmg = dmg - actors[vk].sh; actors[vk].sh = 0.0 }
    }
    actors[vk].hp = actors[vk].hp - dmg
    head
}

// Like apply_hit but with EXPLICIT per-zone damage: head/torso/legs are given as absolute
// numbers, not a multiplier off one base. For weapons whose zone ratios aren't the rifle's
// 2x/0.65x - the Desert Eagle (40 body / 25 legs / 120 head). Same shield-then-health + bypass
// rules; returns 1 on a headshot. Shared by the host (authority) and client (prediction).
fn apply_hit_zoned(actors: [Actor; 9], vk: i64, body: f64, leg: f64, head: f64, hrel: f64, bypass: i64) -> i64 {
    let mut dmg = body
    let mut hs = 0
    if hrel > 0.6 { dmg = head; hs = 1 } else { if hrel < (0.0 - 0.4) { dmg = leg } }
    if bypass == 0 and actors[vk].sh > 0.0 {
        if actors[vk].sh >= dmg { actors[vk].sh = actors[vk].sh - dmg; dmg = 0.0 }
        else { dmg = dmg - actors[vk].sh; actors[vk].sh = 0.0 }
    }
    actors[vk].hp = actors[vk].hp - dmg
    hs
}

// Apply one explosion's effect to actor `j`: linear-falloff radial damage inside `rad`
// (the blast's own source takes half), a hit-flash, and kill-credit to `src`; then -
// inside the wider `krad` - a knockback shove on its brain (kb = push strength along the
// blast normal + a fixed upward pop; pass kb 0 for no shove). `dmg_base` is the full-
// intensity centre damage. Returns 1 if the actor took damage. One source of truth for
// grenade + rocket blasts on both the client (prediction) and the server (authority).
fn blast_hit(actors: [Actor; 9], brains: [Brain; 9], last_hit: [i64; 9], j: i64, src: i64, cx: f64, cy: f64, cz: f64, dmg_base: f64, rad: f64, kb: f64, krad: f64) -> i64 {
    let h = actors[j].hdl
    let bdx = phys3d_x(h) - cx
    let bdy = (phys3d_y(h) + 0.5) - cy
    let bdz = phys3d_z(h) - cz
    let bdd = sqrt(bdx * bdx + bdy * bdy + bdz * bdz)
    let mut hit = 0
    if bdd < rad {
        let mut dmg = dmg_base * (1.0 - 0.30 * bdd / rad)
        if j == src { dmg = dmg * 0.5 }
        apply_hit(actors, j, dmg, 0.0, 0)
        brains[j].pop = 0.15
        last_hit[j] = src
        hit = 1
    }
    if kb > 0.0 and bdd < krad and bdd > 0.01 {
        let kf = kb * (1.0 - bdd / krad)
        brains[j].kx = brains[j].kx + bdx / bdd * kf
        brains[j].ky = brains[j].ky + kf * 0.7 + 12.0
        brains[j].kz = brains[j].kz + bdz / bdd * kf
    }
    hit
}

// True if actor `mt` is a valid katana target from `ox,oy,oz` looking along (fwx,fwy,fwz): within
// `range`, inside the ~120-deg swing arc (forward-dot > 0.5), and with WALL line-of-sight (a wall
// between you and it blocks; your own + the target's capsule don't). `exclude` = the attacker's
// collider. Shared so the client's predicted swing and the host's authoritative one match exactly.
fn in_melee_arc(actors: [Actor; 9], mt: i64, ox: f64, oy: f64, oz: f64, fwx: f64, fwy: f64, fwz: f64, range: f64, exclude: i64) -> i64 {
    let h = actors[mt].hdl
    let tdx = phys3d_x(h) - ox
    let tdy = (phys3d_y(h) + 0.5) - oy
    let tdz = phys3d_z(h) - oz
    let tdd = sqrt(tdx * tdx + tdy * tdy + tdz * tdz)
    if tdd <= 0.001 or tdd >= range { return 0 }
    if (tdx * fwx + tdy * fwy + tdz * fwz) / tdd <= 0.5 { return 0 }
    if phys3d_raycast_world(exclude, ox, oy, oz, tdx / tdd, tdy / tdd, tdz / tdd, tdd) < 0 { return 1 }
    0
}

// Land a katana hit on `mt`: BYPASS shield -> `dmg` straight to green hp, a hit-flash, a horizontal
// shove (hx,hz) via its brain (+ a fixed upward pop), and kill-credit to `attacker`. Shared by the
// host (authoritative swing) and the client (prediction), so the slash resolves identically.
fn melee_hit(actors: [Actor; 9], brains: [Brain; 9], last_hit: [i64; 9], mt: i64, attacker: i64, hx: f64, hz: f64, dmg: f64) {
    apply_hit(actors, mt, dmg, 0.0, 1)
    brains[mt].pop = 0.2
    brains[mt].kx = hx * blast_player_kb()
    brains[mt].ky = 6.0
    brains[mt].kz = hz * blast_player_kb()
    last_hit[mt] = attacker
}
