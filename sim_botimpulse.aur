// Bot impulse authority oracle: a server-authored shove on a passive bot must travel through the
// bot's net input blob (slots 14-16) and then through net_update/sim_step, not a bot-only mover.
fn main() {
    phys3d_init(0.0, 0.0 - 16.0, 0.0)
    phys3d_add_box(0.0, 0.0 - 0.5, 0.0, 20.0, 0.5, 20.0, 0)
    net_host(45135)
    net_dedicated()
    net_cfg_set(3, 1.0)   // passive: no AI movement, so any travel comes from the impulse input
    net_sim(|state, input| { sim::sim_step(state, input, sim::default_cfg()); 0 }, 21, 20)
    let mut w = world::new_world()
    w.round.bots = 1
    net_set_bot_count(w.round.bots)
    w.actors[0].hdl = phys3d_add_character(0.0, 0.9, 0.0, 0.6, 0.3)
    w.actors[0].hp = 100.0
    w.bot_ix[0] = 12.0
    w.bot_iy[0] = 4.0
    w.bot_iz[0] = 0.0
    let startx = phys3d_x(w.actors[0].hdl)
    let mut t = 0
    while t < 30 {
        phys3d_step(0.016)
        server::bots_tick(w, 0.016)
        net_update(0.016)
        t = t + 1
    }
    let endx = phys3d_x(w.actors[0].hdl)
    let moved = endx - startx
    println("passive bot impulse moved x*100=" + str((moved * 100.0) as i64))
    println("RESULT bot-impulse-through-input=" + str((moved > 0.5) as i64) + " (expect 1)")
}
